
<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>YOUR BRAND | Interior Design & Decoration</title>
<meta name="description" content="บริการผ้าม่านและตกแต่งภายในครบวงจร ออกแบบพื้นที่ให้สวยงามและตอบโจทย์ทุกไลฟ์สไตล์">
<style>
:root {
  --cream:#F5F2EC;
  --beige:#DCD2C4;
  --taupe:#A99B89;
  --dark:#393832;
  --white:#fff;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:Arial,"Noto Sans Thai",sans-serif;
  color:var(--dark);
  background:var(--white);
  line-height:1.7;
}
a{text-decoration:none;color:inherit}
button{font:inherit;cursor:pointer}
.container{width:min(1160px,90%);margin:auto}
header{
  position:sticky;top:0;z-index:10;
  background:rgba(245,242,236,.96);
  border-bottom:1px solid #e7e0d6;
}
.nav{
  min-height:82px;display:flex;
  align-items:center;justify-content:space-between;
  gap:20px;
}
.logo{font-size:24px;letter-spacing:3px;font-weight:500}
.logo small{display:block;font-size:9px;letter-spacing:2px}
nav{display:flex;align-items:center;gap:23px}
nav a{font-size:12px;letter-spacing:.5px}
nav a:hover{color:var(--taupe)}
.lang{border:0;background:transparent;font-weight:bold}
.btn{
  display:inline-block;padding:12px 23px;
  background:var(--dark);color:white;
  font-size:12px;letter-spacing:1px;
  border:1px solid var(--dark);
}
.btn.light{background:transparent;color:var(--dark)}
.menu-btn{display:none;background:none;border:0;font-size:25px}
section{padding:90px 0}
.hero{
  min-height:620px;display:flex;align-items:center;
  background:
  linear-gradient(90deg,rgba(35,32,27,.56),rgba(35,32,27,.08)),
  url('assets/images/hero.jpg') center/cover;
  color:white;
}
.hero-content{max-width:650px}
.eyebrow{font-size:11px;letter-spacing:3px;margin-bottom:20px}
h1{font-size:clamp(38px,6vw,68px);line-height:1.13;font-weight:400;margin-bottom:20px}
.hero p{max-width:520px;margin-bottom:28px}
.hero .btn{background:white;color:var(--dark);border-color:white}
.section-title{text-align:center;margin-bottom:45px}
.section-title span{font-size:11px;letter-spacing:3px;color:var(--taupe)}
h2{font-size:34px;font-weight:400;margin:8px 0}
.section-title p{color:#777;max-width:600px;margin:auto;font-size:14px}
.about-grid,.contact-grid{
  display:grid;grid-template-columns:1fr 1fr;
  gap:55px;align-items:center;
}
.photo{
  width:100%;height:410px;object-fit:cover;
  background:var(--cream);
}
.about-text p{color:#777;margin:15px 0 25px;font-size:14px}
.services,.products,.projects{
  display:grid;grid-template-columns:repeat(3,1fr);gap:25px;
}
.card img{
  width:100%;height:245px;object-fit:cover;
  background:var(--cream);
}
.card h3{font-size:17px;font-weight:500;margin:13px 0 4px}
.card p{font-size:13px;color:#777}
.card a{font-size:11px;letter-spacing:1px;display:inline-block;margin-top:12px}
.bg{background:var(--cream)}
.features{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:25px;text-align:center;
}
.feature{padding:20px 10px}
.feature .icon{font-size:30px;color:var(--taupe)}
.feature h3{font-size:15px;margin:12px 0}
.feature p{font-size:12px;color:#777}
.process{
  display:grid;grid-template-columns:repeat(3,1fr);gap:25px;
}
.step{border-top:1px solid var(--beige);padding:20px 0}
.step span{color:var(--taupe);font-size:12px}
.step h3{font-size:16px;font-weight:500;margin:7px 0}
.step p{font-size:13px;color:#777}
.contact-banner{
  background:var(--dark);color:white;
  text-align:center;padding:75px 20px;
}
.contact-banner h2{font-size:clamp(25px,4vw,42px)}
.contact-banner p{color:#d4cec4;margin:15px 0 25px}
.contact-banner .btn{background:white;color:var(--dark)}
form{display:grid;gap:13px}
input,select,textarea{
  width:100%;padding:13px;border:1px solid #ddd;
  background:white;font:inherit;font-size:13px;
}
textarea{min-height:110px}
form button{justify-self:start}
footer{background:var(--dark);color:white;padding:55px 0 20px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px}
footer p,footer a{font-size:12px;color:#ccc}
footer h3{font-size:14px;margin-bottom:15px}
footer a{display:block;margin:8px 0}
.copyright{border-top:1px solid #555;margin-top:35px;padding-top:18px;text-align:center;font-size:11px;color:#aaa}
@media(max-width:900px){
 nav{display:none;position:absolute;top:82px;left:0;width:100%;
 background:var(--cream);padding:25px;flex-direction:column}
 nav.open{display:flex}
 .menu-btn{display:block}
 .services,.products,.projects{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:600px){
 section{padding:65px 0}
 .hero{min-height:540px}
 .about-grid,.contact-grid{grid-template-columns:1fr;gap:25px}
 .services,.products,.projects{grid-template-columns:1fr}
 .features{grid-template-columns:repeat(2,1fr)}
 .process{grid-template-columns:1fr}
 .footer-grid{grid-template-columns:1fr}
 h2{font-size:28px}
}
</style>
</head>
