                <h3 class="text-xl font-bold text-slate-900">ใบเสนอราคา / สรุปสั่งซื้อผ้าม่านทั้งหลัง</h3>
                <p class="text-xs text-slate-500">กรุณาตรวจสอบรายการก่อนโอนชำระเงินมัดจำ 60%</p>
            </div>

            <div id="receipt-content" class="bg-slate-50 p-4 rounded-xl text-xs space-y-3 mb-6 border border-slate-200"></div>

            <div class="space-y-3">
                <button onclick="showToast('บันทึกคำสั่งซื้อผ้าม่านทั้งหลังเรียบร้อย! เจ้าหน้าที่จะติดต่อกลับยืนยันคิวติดตั้งภายใน 15 นาที', 'success'); closeModal();" class="w-full bg-brand-500 hover:bg-brand-600 text-slate-950 font-bold py-3 rounded-xl shadow transition-all">
                    ยืนยันการแจ้งชำระมัดจำ 60%
                </button>
                <button onclick="closeModal()" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium py-2.5 rounded-xl text-xs">
                    กลับไปแก้ไขรายการ
                </button>
            </div>
        </div>
    </div>

    <!-- JavaScript Logic -->
    <script>
        const state = {
            cart: [],
            rooms: [
                {
                    id: 1,
                    name: 'ห้องรับแขก',
                    width: 250,
                    height: 260,
                    style: 'ripple',
                    fabricType: 'dimout',
                    fabricPrice: 350,
                    colorHex: '#64748b',
                    colorName: 'สีเทาโมเดิร์น',
                    railType: 'rail-m',
                    railPrice: 180,
                    hasSheer: true,
                    isTiedBack: true,
                    roomImageBase64: null,
                    calculatedPrice: 0
                }
            ],
            activeRoomIndex: 0,
            selectedService: 'fit-bundle',
            serviceCost: 1500,
            discountAmount: 0,
            paymentMethod: 'qr'
        };

        const curtainStyles = [
            { id: 'ripple', name: 'ม่านลอน', factor: 2.7, icon: 'fa-wave-square' },
            { id: 'pleat', name: 'ม่านจีบ', factor: 2.5, icon: 'fa-align-justify' },
            { id: 'fold', name: 'ม่านพับ', factor: 1.5, icon: 'fa-bars' },
            { id: 'eyelet', name: 'ม่านตาไก่', factor: 2.2, icon: 'fa-ellipsis-h' },
            { id: 'roller', name: 'ม่านม้วน', factor: 1.2, icon: 'fa-scroll' }
        ];

        const colorPalette = [
            { name: 'สีเทาโมเดิร์น', hex: '#64748b' },
            { name: 'สีเบจคลาสสิก', hex: '#d4b996' },
            { name: 'สีครีมมินิมอล', hex: '#f3e8d3' },
            { name: 'สีน้ำเงินพรีเมียม', hex: '#1e3a8a' },
            { name: 'สีน้ำตาลโฮมมี่', hex: '#78350f' },
            { name: 'สีขาวโปร่ง', hex: '#f8fafc' }
        ];

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgClass = type === 'error' ? 'bg-red-600' : type === 'success' ? 'bg-emerald-600' : 'bg-slate-900';
            toast.className = `${bgClass} text-white text-xs px-4 py-3 rounded-xl shadow-xl flex items-center space-x-2 toast-animate pointer-events-auto border border-slate-700`;
            toast.innerHTML = `<i class="fa-solid ${type === 'error' ? 'fa-circle-exclamation text-red-300' : 'fa-circle-check text-emerald-300'} text-base"></i> <span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => { toast.remove(); }, 3500);
        }

        window.onload = function() {
            renderStyleOptions();
            renderColorOptions();
            renderRoomTabs();
            syncActiveRoomUI();
            updateCartBadge();
        };

        function scrollToSection(id) {
            document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
        }

        function renderRoomTabs() {
            const container = document.getElementById('room-tabs-container');
            container.innerHTML = state.rooms.map((room, idx) => `
                <button type="button" onclick="switchActiveRoom(${idx})" 
                    class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-2 whitespace-nowrap ${idx === state.activeRoomIndex ? 'bg-slate-950 text-brand-400 shadow-md ring-1 ring-slate-800' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}">
                    <i class="fa-solid fa-door-open ${idx === state.activeRoomIndex ? 'text-brand-500' : 'text-slate-400'}"></i>
                    <span>${room.name}</span>
                </button>
            `).join('');

            document.getElementById('total-rooms-count').innerText = state.rooms.length;
        }

        function switchActiveRoom(index) {
            state.activeRoomIndex = index;
            renderRoomTabs();
            syncActiveRoomUI();
        }

        function addNewRoom() {
            const roomNum = state.rooms.length + 1;
            const newRoom = {
                id: Date.now(),
                name: `ห้องนอน ${roomNum}`,
                width: 200,
                height: 250,
                style: 'ripple',
                fabricType: 'dimout',
                fabricPrice: 350,
                colorHex: '#64748b',
                colorName: 'สีเทาโมเดิร์น',
                railType: 'rail-m',
                railPrice: 180,
                hasSheer: true,
                isTiedBack: true,
                roomImageBase64: null,
                calculatedPrice: 0
            };
            state.rooms.push(newRoom);
            state.activeRoomIndex = state.rooms.length - 1;
            renderRoomTabs();
            syncActiveRoomUI();
            showToast(`เพิ่ม ${newRoom.name} เรียบร้อยแล้ว`, 'success');
        }

        function deleteCurrentRoom() {
            if (state.rooms.length <= 1) {
                showToast('ต้องมีอย่างน้อย 1 ห้องสำหรับคำนวณราคาทั้งหลัง', 'error');
                return;
            }
            const deletedName = state.rooms[state.activeRoomIndex].name;
            state.rooms.splice(state.activeRoomIndex, 1);
            state.activeRoomIndex = Math.max(0, state.activeRoomIndex - 1);
            renderRoomTabs();
            syncActiveRoomUI();
            showToast(`ลบ ${deletedName} เรียบร้อยแล้ว`);
        }

        function copyCurrentRoomSettings() {
            if (state.rooms.length <= 1) {
                showToast('กรุณาเพิ่มห้องใหม่ก่อนกดคัดลอกสเปก', 'info');
                return;
            }
            const srcRoom = state.rooms[state.activeRoomIndex];
            state.rooms.forEach((r, idx) => {
                if (idx !== state.activeRoomIndex) {
                    r.style = srcRoom.style;
                    r.fabricType = srcRoom.fabricType;
                    r.fabricPrice = srcRoom.fabricPrice;
                    r.colorHex = srcRoom.colorHex;
                    r.colorName = srcRoom.colorName;
                    r.railType = srcRoom.railType;
                    r.railPrice = srcRoom.railPrice;
                    r.hasSheer = srcRoom.hasSheer;
                    r.isTiedBack = srcRoom.isTiedBack;
                }
            });
            updateCurtainCalculation();
            showToast('คัดลอกสเปกม่านไปยังทุกห้องในบ้านเรียบร้อยแล้ว!', 'success');
        }

        function updateRoomName(newName) {
            if (newName.trim()) {
                state.rooms[state.activeRoomIndex].name = newName.trim();
                renderRoomTabs();
                document.getElementById('current-room-title').innerText = newName.trim();
                document.getElementById('preview-room-title').innerText = newName.trim();
            }
        }

        function syncActiveRoomUI() {
            const currentRoom = state.rooms[state.activeRoomIndex];
            document.getElementById('room-name-input').value = currentRoom.name;
            document.getElementById('current-room-title').innerText = currentRoom.name;
            document.getElementById('preview-room-title').innerText = currentRoom.name;
            document.getElementById('curtain-width').value = currentRoom.width;
            document.getElementById('curtain-height').value = currentRoom.height;
            document.getElementById('toggle-sheer').checked = currentRoom.hasSheer;
            document.getElementById('toggle-tieback').checked = currentRoom.isTiedBack;

            const fabricSelect = document.getElementById('fabric-type');
            for (let opt of fabricSelect.options) {
                if (opt.value === currentRoom.fabricType) {
                    fabricSelect.value = currentRoom.fabricType;
                    break;
                }
            }

            const railSelect = document.getElementById('rail-type');
            for (let opt of railSelect.options) {
                if (opt.value === currentRoom.railType) {
                    railSelect.value = currentRoom.railType;
                    break;
                }
            }

            const imgEl = document.getElementById('preview-bg-img');
            const logoEl = document.getElementById('preview-logo-placeholder');
            if (currentRoom.roomImageBase64) {
                imgEl.src = `data:image/jpeg;base64,${currentRoom.roomImageBase64}`;
                imgEl.classList.remove('hidden');
                logoEl.classList.add('hidden');
            } else {
                imgEl.classList.add('hidden');
                logoEl.classList.remove('hidden');
            }

            renderStyleOptions();
            renderColorOptions();
            updateCurtainCalculation();
        }

        function renderStyleOptions() {
            const container = document.getElementById('style-options');
            const currentStyle = state.rooms[state.activeRoomIndex].style;
            container.innerHTML = curtainStyles.map(st => `
                <button type="button" onclick="selectStyle('${st.id}')" id="style-btn-${st.id}" 
                    class="style-option border rounded-xl p-3 text-center transition-all flex flex-col items-center justify-center hover:border-brand-500 ${st.id === currentStyle ? 'border-2 border-brand-500 bg-brand-50/40 text-brand-800 font-bold' : 'border-slate-200 text-slate-600 bg-slate-50'}">
                    <i class="fa-solid ${st.icon} text-lg mb-1"></i>
                    <span class="text-xs">${st.name}</span>
                </button>
            `).join('');
        }

        function renderColorOptions() {
            const container = document.getElementById('color-options');
            const currentHex = state.rooms[state.activeRoomIndex].colorHex;
            container.innerHTML = colorPalette.map(c => `
                <button type="button" onclick="selectColor('${c.hex}', '${c.name}')" title="${c.name}" 
                    class="w-8 h-8 rounded-full border-2 transition-transform transform hover:scale-110 flex items-center justify-center shadow-sm ${c.hex === currentHex ? 'border-brand-500 ring-2 ring-brand-500/40 scale-110' : 'border-slate-300'}" 
                    style="background-color: ${c.hex}">
                </button>
            `).join('');
        }

        function selectStyle(styleId) {
            state.rooms[state.activeRoomIndex].style = styleId;
            renderStyleOptions();
            updateCurtainCalculation();
        }

        function selectColor(hex, name) {
            state.rooms[state.activeRoomIndex].colorHex = hex;
            state.rooms[state.activeRoomIndex].colorName = name;
            renderColorOptions();
            updateCurtainCalculation();
        }

        function updateCurtainCalculation() {
            const currentRoom = state.rooms[state.activeRoomIndex];
            
            let width = parseFloat(document.getElementById('curtain-width').value) || 0;
            let height = parseFloat(document.getElementById('curtain-height').value) || 0;

            currentRoom.width = width;
            currentRoom.height = height;
            currentRoom.hasSheer = document.getElementById('toggle-sheer').checked;
            currentRoom.isTiedBack = document.getElementById('toggle-tieback').checked;

            const fabricSelect = document.getElementById('fabric-type');
            const selectedFabricOption = fabricSelect.options[fabricSelect.selectedIndex];
            currentRoom.fabricType = fabricSelect.value;
            currentRoom.fabricPrice = parseFloat(selectedFabricOption.dataset.price);

            const railSelect = document.getElementById('rail-type');
            const selectedRailOption = railSelect.options[railSelect.selectedIndex];
            currentRoom.railType = railSelect.value;
            currentRoom.railPrice = parseFloat(selectedRailOption.dataset.price);

            let wholeHouseTotal = 0;
            state.rooms.forEach(r => {
                const sqm = (r.width / 100) * (r.height / 100);
                const sqy = sqm * 1.2;
                const styleObj = curtainStyles.find(s => s.id === r.style) || curtainStyles[0];
                const sheerExtra = r.hasSheer ? (sqy * 220) : 0;

                const fabricCost = (sqy * styleObj.factor) * r.fabricPrice + sheerExtra;
                const railCost = (r.width / 100) * r.railPrice * (r.hasSheer ? 1.7 : 1);

                r.calculatedPrice = Math.max(Math.round(fabricCost + railCost), 300);
                wholeHouseTotal += r.calculatedPrice;
            });

            const curSqm = (width / 100) * (height / 100);
            document.getElementById('sqm-calc').innerText = curSqm.toFixed(2);
            document.getElementById('sqy-calc').innerText = (curSqm * 1.2).toFixed(2);

            document.getElementById('calculated-price').innerText = `${currentRoom.calculatedPrice.toLocaleString()} บาท`;
            document.getElementById('whole-house-total-price').innerText = `${wholeHouseTotal.toLocaleString()} บาท`;
        }

        function handlePhotoUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const result = e.target.result;
                    const base64Data = result.split(',')[1];
                    state.rooms[state.activeRoomIndex].roomImageBase64 = base64Data;
                    
                    const imgEl = document.getElementById('preview-bg-img');
                    imgEl.src = result;
                    imgEl.classList.remove('hidden');
                    document.getElementById('preview-logo-placeholder').classList.add('hidden');
                    
                    showToast(`อัปโหลดรูป ${state.rooms[state.activeRoomIndex].name} เรียบร้อยแล้ว`, 'success');
                }
                reader.readAsDataURL(file);
            }
        }

        function resetDefaultPhoto() {
            const sampleUrl = 'https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1000&q=80';
            const imgEl = document.getElementById('preview-bg-img');
            imgEl.crossOrigin = 'Anonymous';
            imgEl.src = sampleUrl;
            imgEl.classList.remove('hidden');
            document.getElementById('preview-logo-placeholder').classList.add('hidden');
            
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            const image = new Image();
            image.crossOrigin = 'Anonymous';
            image.onload = function() {
                canvas.width = image.width;
                canvas.height = image.height;
                ctx.drawImage(image, 0, 0);
                const b64 = canvas.toDataURL('image/jpeg').split(',')[1];
                state.rooms[state.activeRoomIndex].roomImageBase64 = b64;
                showToast(`โหลดรูปภาพห้องตัวอย่างสำหรับ ${state.rooms[state.activeRoomIndex].name}`);
            };
            image.src = sampleUrl;
        }

        async function generateAiCurtainPreview() {
            const loadingOverlay = document.getElementById('ai-loading-overlay');
            loadingOverlay.classList.remove('hidden');

            const currentRoom = state.rooms[state.activeRoomIndex];
            const styleObj = curtainStyles.find(s => s.id === currentRoom.style) || curtainStyles[0];

            let promptText = `A realistic interior design photo showing installed window curtains in a room. `;
            promptText += `Curtain Style: ${styleObj.name} (${styleObj.id} fold curtain). `;
            promptText += `Curtain Fabric Color: ${currentRoom.colorName}. `;
            promptText += `Rail Type: ${currentRoom.railType}. `;
            if (currentRoom.hasSheer) {
                promptText += `Includes a soft white sheer curtain layer behind the main drape. `;
            }
            if (currentRoom.isTiedBack) {
                promptText += `The main drape curtains are pulled and neatly tied back to both sides with matching fabric straps, showing elegant curved fabric folds. `;
            } else {
                promptText += `The main drape curtains hang straight down covering the sides of the window. `;
            }
            promptText += `High quality architectural photograph, natural indoor lighting, soft realistic fabric texture and shadows.`;

            try {
                const apiKey = "";
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent?key=${apiKey}`;

                let parts = [{ text: promptText }];

                if (currentRoom.roomImageBase64) {
                    parts.unshift({
                        inlineData: {
                            mimeType: "image/jpeg",
                            data: currentRoom.roomImageBase64
                        }
                    });
                    parts[1].text = `Install customized window curtains onto the window shown in this room photo. ` + promptText;
                }

                const payload = {
                    contents: [{
                        role: "user",
                        parts: parts
                    }],
                    generationConfig: {
                        responseModalities: ['IMAGE']
                    }
                };

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                const part = result?.candidates?.[0]?.content?.parts?.find(p => p.inlineData);

                if (part && part.inlineData && part.inlineData.data) {
                    const generatedImgData = `data:${part.inlineData.mimeType};base64,${part.inlineData.data}`;
                    const imgEl = document.getElementById('preview-bg-img');
                    imgEl.src = generatedImgData;
                    imgEl.classList.remove('hidden');
                    document.getElementById('preview-logo-placeholder').classList.add('hidden');
                    showToast(`สร้างภาพจำลอง AI สำหรับ ${currentRoom.name} สำเร็จ!`, 'success');
                } else {
                    showToast('ไม่สามารถสร้างภาพได้ชั่วคราว กรุณาลองใหม่อีกครั้ง', 'error');
                }
            } catch (err) {
                console.error("AI Generation Error:", err);
                showToast('เกิดข้อผิดพลาดในการเชื่อมต่อ AI สำหรับสร้างภาพ', 'error');
            } finally {
                loadingOverlay.classList.add('hidden');
            }
        }

        function addAllRoomsToCart() {
            updateCurtainCalculation();
            state.cart = state.cart.filter(item => item.type !== 'สั่งตัดผ้าม่านทั้งหลัง');

            state.rooms.forEach(room => {
                const styleName = (curtainStyles.find(s=>s.id===room.style)||curtainStyles[0]).name;
                state.cart.push({
                    id: Date.now() + Math.random(),
                    type: 'สั่งตัดผ้าม่านทั้งหลัง',
                    title: `ม่านสั่งตัด: ${room.name}`,
                    details: `ทรง ${styleName} (${room.width}x${room.height} ซม.) | ผ้า: ${room.colorName} | ราง: ${room.railType}`,
                    price: room.calculatedPrice,
                    qty: 1
                });
            });

            updateCartBadge();
            confirmOrderModal();
        }

        function updateCartBadge() {
            document.getElementById('cart-badge').innerText = state.cart.length;
        }

        function confirmOrderModal() {
            if (state.cart.length === 0) {
                showToast('กรุณาคลิกบรรจุทั้งหลังลงตะกร้าก่อนดูสรุปราคา', 'error');
                return;
            }

            const itemsTotal = state.cart.reduce((sum, item) => sum + item.price, 0);
            const grandTotal = itemsTotal;
            const deposit60 = Math.round(grandTotal * 0.6);

            const receiptHtml = `
                <div class="border-b pb-2 mb-2">
                    <span class="font-bold text-slate-800 block mb-1">รายการสั่งตัดผ้าม่านทั้งหลัง:</span>
                    ${state.cart.map(i => `<div class="flex justify-between text-slate-600 mb-1"><span>- ${i.title} (${i.details})</span> <span class="font-semibold">${i.price.toLocaleString()} บ.</span></div>`).join('')}
                </div>
                <div class="flex justify-between font-bold text-slate-900 text-sm border-t pt-2 mt-2">
                    <span>ยอดรวมประเมินผ้าม่านทั้งหลัง:</span>
                    <span class="text-brand-600">${grandTotal.toLocaleString()} บาท</span>
                </div>
                <div class="bg-brand-50 text-brand-900 p-3 rounded-xl border border-brand-300 font-bold flex justify-between items-center mt-3">
                    <span>ยอดชำระมัดจำสินค้าสั่งตัด (60%):</span>
                    <span class="text-red-600 text-lg">${deposit60.toLocaleString()} บาท</span>
                </div>
            `;

            document.getElementById('receipt-content').innerHTML = receiptHtml;
            document.getElementById('order-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('order-modal').classList.add('hidden');
        }
    </script>
</body>
